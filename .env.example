# Sathya Sai Grama Visitor Management System Configuration Template
PORT=5004

# Active Environment: local | uat | beta | production
APP_ENV=uat

# Connection Strings per Environment
LOCAL_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/vm
UAT_CONNECTION_STRING=postgresql://user:pass@host/dbname?sslmode=require
BETA_CONNECTION_STRING=
PROD_CONNECTION_STRING=

# Database Defaults & JWT
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vm
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your_jwt_secret_key_here

# Application & Frontend URLs
FRONTEND_URL=https://vms-qrf6.onrender.com
CORS_ORIGIN=https://vms-qrf6.onrender.com,http://localhost:5173

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Sathya Sai Grama VMS" <noreply@sathyasaigrama.org>

# Visitor Access Policy Defaults
PASS_TIME_WINDOW_GRACE_HOURS=8
L2_APPROVAL_ENABLED=true
